# ==============================================================================
# NBA Player Performance Rating API & Pipeline Environment Configuration
# ==============================================================================

# Directory where canonical Parquet datasets and serving artifacts are stored
PROPREDICT_DATA_DIR=./data

# Comma-separated list of allowed CORS origins for the FastAPI backend
PROPREDICT_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-domain.com

# Deployment environment mode: "production" or "development"
PROPREDICT_ENV=production

# Uvicorn auto-reload (development only; set to false in production)
PROPREDICT_RELOAD=false

# Daily Pipeline Scheduled Execution Time (local 24h format HH:MM, default 06:00)
PROPREDICT_SCHEDULE_TIME=06:00

# Optional: Set to true if you need to generate legacy static JSON files in lineup-builder/public
PROPREDICT_EXPORT_STATIC_JSON=false
