[Unit]
Description=NBA Player Performance Prediction FastAPI Serving Layer
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/propredict
EnvironmentFile=/var/www/propredict/.env
ExecStart=/var/www/propredict/venv/bin/uvicorn api.main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
